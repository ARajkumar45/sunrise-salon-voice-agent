# Copy this file to .env and fill in the values. Never commit .env.

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# LiveKit Cloud project (Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres. The defaults work with docker compose as they are.
# Change POSTGRES_PASSWORD on any machine that is reachable from the internet.
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=receptionist
DATABASE_URL=postgresql://receptionist:change-me@db:5432/receptionist

# Public hostname Caddy gets an HTTPS certificate for. Use "localhost" on a laptop.
SITE_HOST=localhost

# Key that protects the call-log pages. Pick any long random string.
ADMIN_KEY=
