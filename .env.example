# Copy this file to .env and fill in the values. Never commit .env.

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Optional second LLM provider (same open model, gpt-oss-120b): https://cloud.cerebras.ai
# Leave empty to run on Groq alone.
CEREBRAS_API_KEY=

# LiveKit Cloud project (Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres. The defaults work with docker compose as they are.
# Change POSTGRES_PASSWORD on any machine that is reachable from the internet.
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=receptionist
# DATABASE_URL is built from these three by docker compose.

# Public hostname Caddy gets an HTTPS certificate for. Use "localhost" on a laptop.
SITE_HOST=localhost

# Which business the bare address (/) opens. Every business also has /call/<its-slug>.
DEFAULT_BUSINESS=sunrise-salon

# Key that protects the owner page (/admin/<business>?key=...). Pick any long random string.
ADMIN_KEY=

# Optional. Change these only if the default ports are taken on your machine.
# WEB_PORT=8000
# HTTP_PORT=80
# HTTPS_PORT=443

# Optional. Defaults shown; uncomment to change.
# LLM_MODELS=cerebras:gpt-oss-120b,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
#   (order in which the open models are tried; Cerebras entries are skipped without its key)
# LLM_REASONING=medium        # low is a little faster, medium follows the rules better
# MAX_REPLY_TOKENS=700
# AGENT_NAME=receptionist     # change it to run a second stack against the same LiveKit project
# DB_POOL_MAX=5
